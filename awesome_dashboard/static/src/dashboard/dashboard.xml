<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout className="'o_dashboard h-100 overflow-auto'" display="display">
            <t t-set-slot="control-panel-create-buttons">
                <button class="btn btn-primary" t-on-click="openCustomers">Customers</button>
                <button class="btn btn-primary" t-on-click="openLeads">Leads</button>
                <button class="btn btn-secondary ms-1" t-on-click="openConfiguration">
                    <i class="fa fa-cog"/>
                </button>
            </t>
            <div class="p-3 d-flex flex-wrap align-items-start">
                <t t-foreach="items" t-as="item" t-key="item.id">
                    <DashboardItem size="item.size || 1">
                        <t t-set="itemProps" t-value="item.props ? item.props(statistics) : {data: statistics}"/>
                        <t t-component="item.Component" t-props="itemProps"/>
                    </DashboardItem>
                </t>
            </div>
        </Layout>
    </t>

</templates>
