<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.TodoItem">
        <div class="t-todo-item d-flex align-items-center justify-content-between border-bottom p-2" t-att-class="props.todo.isCompleted ? 'text-muted text-decoration-line-through' : ''">
            <div class="d-flex align-items-center flex-grow-1">
                <input type="checkbox" class="form-check-input me-2" t-att-checked="props.todo.isCompleted" t-on-change="onChange"/>
                <span t-esc="props.todo.description"/>
            </div>
            <span class="fa fa-remove text-danger cursor-pointer" style="cursor: pointer;" t-on-click="onRemove"/>
        </div>
    </t>
</templates>
