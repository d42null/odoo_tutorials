<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.TodoList">
        <div class="todo-list-container bg-white shadow-sm p-3 rounded">
            <div class="input-group mb-3">
                <input type="text" class="form-control" placeholder="Add a new todo..." t-on-keyup="addTodo"/>
            </div>
            
            <div class="todo-list">
                <t t-foreach="state.todos" t-as="todo" t-key="todo.id">
                    <TodoItem todo="todo" toggleState.bind="toggleTodo" removeTodo.bind="deleteTodo"/>
                </t>
            </div>
            
            <div class="mt-2 text-end text-muted small">
                <span t-esc="state.todos.length"/> tasks
            </div>
        </div>
    </t>
</templates>
