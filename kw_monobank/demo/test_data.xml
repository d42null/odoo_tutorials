<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Bank -->
    <record id="demo_monobank_bank" model="res.bank">
        <field name="name">Monobank</field>
        <field name="active">True</field>
        <field name="bic">MONO123</field>
    </record>

    <!-- Partner -->
    <record id="demo_monobank_partner" model="res.partner">
        <field name="name">Test Partner</field>
    </record>

    <!-- Company -->
    <record id="demo_monobank_company" model="res.company">
        <field name="name">Monobank Company</field>
        <field name="partner_id" ref="kw_monobank.demo_monobank_partner"/>
    </record>

    <!-- Bank Account -->
    <record id="demo_monobank_bank_account" model="res.partner.bank">
        <field name="acc_number">UA573052990000026002005022255</field>
        <field name="bank_id" ref="kw_monobank.demo_monobank_bank"/>
        <field name="partner_id" ref="kw_monobank.demo_monobank_partner"/>
        <field name="company_id" ref="kw_monobank.demo_monobank_company"/>
        <field name="currency_id" ref="base.UAH"/>
    </record>

    <!-- Accounts -->
    <record id="demo_monobank_debit_account" model="account.account">
        <field name="name">Default Debit Account</field>
        <field name="code">DEBIT.ACC3</field>
        <field name="account_type">asset_current</field>
        <field name="company_ids" eval="[(4, ref('kw_monobank.demo_monobank_company'))]"/>
    </record>

    <record id="demo_monobank_credit_account" model="account.account">
        <field name="name">Default Credit Account</field>
        <field name="code">CREDIT.ACC3</field>
        <field name="account_type">liability_current</field>
        <field name="company_ids" eval="[(4, ref('kw_monobank.demo_monobank_company'))]"/>
    </record>

    <record id="demo_monobank_suspense_account" model="account.account">
        <field name="name">Suspense Account</field>
        <field name="code">SUSPENSE.ACC3</field>
        <field name="account_type">asset_current</field>
        <field name="company_ids" eval="[(4, ref('kw_monobank.demo_monobank_company'))]"/>
    </record>

    <!-- Journal -->
    <record id="demo_monobank_journal" model="account.journal">
        <field name="name">Monobank_Test</field>
        <field name="type">bank</field>
        <field name="code">MONO_TEST</field>
        <field name="bank_account_id" ref="kw_monobank.demo_monobank_bank_account"/>
        <field name="default_debit_account_id" ref="kw_monobank.demo_monobank_debit_account"/>
        <field name="default_credit_account_id" ref="kw_monobank.demo_monobank_credit_account"/>
        <field name="suspense_account_id" ref="kw_monobank.demo_monobank_suspense_account"/>
        <field name="bank_statements_source">monobank</field>
        <field name="kw_monobank_token">test_token</field>
        <field name="kw_bank_import_initial_date">2021-01-01</field>
        <field name="company_id" ref="kw_monobank.demo_monobank_company"/>
    </record>
</odoo>
