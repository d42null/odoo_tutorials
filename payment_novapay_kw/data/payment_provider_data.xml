<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_novapay" model="payment.provider">
        <field name="name">NovaPay</field>
        <field name="code">novapay</field>
        <field name="redirect_form_view_id" ref="redirect_form"/>
        <field name="module_id" ref="base.module_payment_novapay_kw"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="image_128" type="base64"
               file="payment_novapay_kw/static/src/img/novapay_icon.png"/>
        <field name="pre_msg">
            <![CDATA[<p>You will be redirected to the NovaPay website after clicking on the payment button.</p>]]>
        </field>
        <field name="novapay_merchant_id">1</field>
        <field name="novapay_auth_token"></field>
    </record>

    <record id="payment_method_monobank" model="payment.method">
        <field name="name">NovaPay</field>
        <field name="code">novapay</field>
        <field name="image" type="base64"
               file="payment_novapay_kw/static/src/img/novapay_icon.png"/>
        <field name="provider_ids"
               eval="[(6, 0, [
                   ref('payment_novapay_kw.payment_provider_novapay'),
               ])]"/>
    </record>

</odoo>
