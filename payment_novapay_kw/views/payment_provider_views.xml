<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">NovaPay Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr='//group[@name="provider_credentials"]' position="after">
                <group name="provider_credentials" position="inside">
                    <group invisible="code != 'novapay'">
                        <field name="novapay_merchant_id" required="code == 'novapay' and state != 'disabled'"/>
                        <field name="novapay_auth_token" password="True"/>
                        <a colspan="2" href="https://novapay.ua/" target="_blank">
                            How to configure your NovaPay account?
                        </a>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
